# Copy this to .env and fill in before running `docker compose up`.
#
# Generate CREDENTIALS_ENCRYPTION_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# This key encrypts firewall credentials at rest in Postgres. Losing it means
# losing access to every stored device credential (they'd need to be re-entered).
# Treat it like any other secret — don't commit the real value to source control.
CREDENTIALS_ENCRYPTION_KEY=GiNKt3DCHJ08La5JsqpbrZmESnWEg9wSzqtFU9jJSUM=

# Optional overrides
METRICS_POLL_INTERVAL_SECONDS=30
DIGITAL_TWIN_CACHE_TTL_SECONDS=20

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=EomamIyG92AJ3SvNOrBqm4LlXt7Ij-IpyHdFpWMRNGk
JWT_EXPIRY_MINUTES=480

# Bootstrapped only if the users table is empty on first startup. Change this
# password immediately after first login in any real deployment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Kushal@4757

# Secrets backend: "fernet" (default) or "vault". If "vault", also set
# VAULT_ADDR and VAULT_TOKEN. NOTE: the Vault backend was built and unit
# tested against a mocked client only — it has not been run against a real
# Vault server. Smoke-test it before trusting it with real credentials.
SECRETS_BACKEND=fernet
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
